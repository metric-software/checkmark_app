cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED OUTPUT_FILE)
  message(FATAL_ERROR "OUTPUT_FILE is required")
endif()

foreach(var VS_5_0 PS_5_0 VS_4_0 PS_4_0)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "${var} is required")
  endif()
  if(NOT EXISTS "${${var}}")
    message(FATAL_ERROR "${var} not found: ${${var}}")
  endif()
endforeach()

function(_read_shader out_data out_size path)
  file(READ "${path}" _hex HEX)
  string(REGEX REPLACE "[^0-9A-Fa-f]" "" _hex "${_hex}")
  string(REGEX MATCHALL ".." _bytes "${_hex}")
  list(LENGTH _bytes _count)

  math(EXPR _last "${_count} - 1")

  set(_formatted "  ")
  foreach(i RANGE 0 ${_last})
    list(GET _bytes ${i} _byte)
    string(APPEND _formatted "0x${_byte}")
    if(NOT i EQUAL ${_count}-1)
      string(APPEND _formatted ",")
    endif()
    math(EXPR _mod "( ${i} + 1 ) % 12")
    if(_mod EQUAL 0 AND NOT i EQUAL ${_count}-1)
      string(APPEND _formatted "\n  ")
    elseif(NOT i EQUAL ${_count}-1)
      string(APPEND _formatted " ")
    endif()
  endforeach()

  set(${out_data} "${_formatted}" PARENT_SCOPE)
  set(${out_size} "${_count}" PARENT_SCOPE)
endfunction()

_read_shader(VS50_DATA VS50_SIZE "${VS_5_0}")
_read_shader(PS50_DATA PS50_SIZE "${PS_5_0}")
_read_shader(VS40_DATA VS40_SIZE "${VS_4_0}")
_read_shader(PS40_DATA PS40_SIZE "${PS_4_0}")

file(WRITE "${OUTPUT_FILE}" "/* Auto-generated by emit_shader_header.cmake - do not edit. */\n")
file(APPEND "${OUTPUT_FILE}" "#pragma once\n\n#include <array>\n#include <cstdint>\n\nnamespace gpu_test_shaders {\n")

file(APPEND "${OUTPUT_FILE}" "constexpr std::array<std::uint8_t, ${VS50_SIZE}> kVS_5_0 = {\n${VS50_DATA}\n};\n\n")
file(APPEND "${OUTPUT_FILE}" "constexpr std::array<std::uint8_t, ${PS50_SIZE}> kPS_5_0 = {\n${PS50_DATA}\n};\n\n")
file(APPEND "${OUTPUT_FILE}" "constexpr std::array<std::uint8_t, ${VS40_SIZE}> kVS_4_0 = {\n${VS40_DATA}\n};\n\n")
file(APPEND "${OUTPUT_FILE}" "constexpr std::array<std::uint8_t, ${PS40_SIZE}> kPS_4_0 = {\n${PS40_DATA}\n};\n\n")

file(APPEND "${OUTPUT_FILE}" "}  // namespace gpu_test_shaders\n")
